+// The authenticated connection context, not caller-controlled MsgData, identifies the sender.
+func validateRAPMessage(ctx context.Context, data *sdkws.MsgData) error {
+	userID, platform := mcontext.GetOpUserID(ctx), mcontext.GetOpUserPlatform(ctx)
+	if userID == "" || data.SendID != userID || platform == "" ||
+		constant.PlatformIDToName(int(data.SenderPlatformID)) != platform ||
+		data.SenderPlatformID == constant.AdminPlatformID || data.MsgFrom != constant.UserMsgType ||
+		(data.ContentType >= constant.NotificationBegin && data.ContentType <= constant.NotificationEnd) {
+		return errs.ErrNoPermission.WrapMsg("research IM sender identity required")
+	}
+	return nil
+}
