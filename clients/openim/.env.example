VITE_RESEARCH_MODE=true
# Development: Vite proxies /api to the research service; APP_ORIGIN must match the client origin.
VITE_RESEARCH_PROXY=http://127.0.0.1:3217
# Explicit development tools opt-in; hidden by default.
VITE_RESEARCH_DEVTOOLS=false
# Only this explicit media origin or same-origin SDK files may be read after a user click.
# Cross-origin redirects are refused; expired/gateway links can use local file selection.
VITE_RESEARCH_FILE_ORIGIN=https://files.chat.acceptcat.com
# OpenIM API/ws configuration is returned by the authenticated /api/v1/im/session.
# Standalone upstream mode (VITE_RESEARCH_MODE=false) retains its original config:
VITE_BASE_HOST=your-server-ip
VITE_WS_URL=ws://$VITE_BASE_HOST:10001
VITE_API_URL=http://$VITE_BASE_HOST:10002
VITE_CHAT_URL=http://$VITE_BASE_HOST:10008
